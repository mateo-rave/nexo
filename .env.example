# Copia este archivo a .env para desarrollo local y reemplaza los valores de ejemplo.
# No pongas credenciales reales en este archivo ni lo subas con secretos.
# Arquitectura provisional: Supabase (backend) + Vercel (frontend). Ver docs/architecture/decisions/.

# --- Supabase: valores públicos (pueden llegar al navegador; la protección es RLS) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-dev-key

# --- Supabase: valores secretos (solo servidor, Edge Functions, CLI o CI de pruebas) ---
# NUNCA en el frontend, en variables públicas de Vercel ni en Git.
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-dev-key
# Cadena de conexión para la CLI, respaldos o herramientas de administración.
SUPABASE_DB_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:54322/postgres

# --- Edge Functions ---
# Orígenes autorizados para CORS (dominios del frontend por entorno).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Stitch) ---
# El prefijo de variables públicas (VITE_, NEXT_PUBLIC_, ...) depende del framework que genere Stitch.
# Se definirá al inspeccionar el código; solo URL y clave publicable deben exponerse.

# --- Opcional futuro: no habilitar hasta implementar el componente ---
# Proveedor de correo para notificaciones externas (pendiente de elegir).
EMAIL_PROVIDER_API_KEY=
# Observabilidad externa (pendiente de elegir); dejar vacío si no está configurada.
LOG_LEVEL=info
